generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GESTOR_GARRO
  ATENDENTE
  EDITOR
}

enum OpportunityStage {
  LEAD
  SEM_INTERESSE
  REUNIAO_AGENDADA
  REUNIAO_REALIZADA
  BOLO
  NOVO_CONTATO
  EM_ATENDIMENTO
  PROPOSTA_ENVIADA
  EM_NEGOCIACAO
  AGUARDANDO_CLIENTE
  FOLLOW_UP
  EM_TRATATIVA
  FECHADO
  PERDIDO
}

enum OpportunityOutcome {
  ABERTA
  GANHA
  PERDIDA
}

enum WaitingOn {
  NINGUEM
  CLIENTE
  GARRO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
}

enum DemandStatus {
  NOVA
  PLANEJAMENTO
  AGUARDANDO_EDITOR
  EM_PRODUCAO
  ENVIADO_REVISAO
  EM_REVISAO
  CORRECAO
  PRONTO_ENTREGA
  ENTREGUE
  CONCLUIDO
}

enum DemandMediaType {
  VIDEO
  FOTO
  FOTO_E_VIDEO
}

enum DeliverableStatus {
  AGUARDANDO_EDITOR
  EM_PRODUCAO
  ENVIADO_REVISAO
  EM_REVISAO
  CORRECAO
  APROVADO
  ENTREGUE
  CONCLUIDO
}

enum ScheduleEventType {
  FOLLOW_UP
  CONTATO_FUTURO
  REUNIAO
  RETORNO_ORCAMENTO
  ENTREGA_EDITOR
  REVISAO_GARRO
  ENTREGA_CLIENTE
  CORRECAO
  GRAVACAO
  EVENTO
  INTERNO
  TAREFA_ATENDENTE
}

enum EventStatus {
  PENDENTE
  CONCLUIDO
  CANCELADO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  username     String?  @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions           Session[]
  opportunities      Opportunity[]    @relation("OpportunityResponsible")
  interactions       CrmInteraction[]
  editedDeliverables Deliverable[]    @relation("DeliverableEditor")
  messages           DemandMessage[]
  uploadedFiles      DemandFile[]
  scriptAttachments ScriptAttachment[]
  events             ScheduleEvent[] @relation("ScheduleOwner")
  authoredEvents     ScheduleEvent[] @relation("ScheduleAuthor")
  notifications      Notification[]
  drafts             Draft[]
  auditLogs          AuditLog[]
  customersCreated   Customer[] @relation("CustomerCreator")
  serviceProposals   ServiceProposal[] @relation("ServiceProposalAuthor")
  serviceReviews     ServiceProposal[] @relation("ServiceProposalReviewer")

  @@index([role, active])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ContactKind {
  LEAD
  CLIENTE
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  kind      ContactKind @default(LEAD)
  phone     String?
  email     String?
  company   String?
  origin    String?
  notes       String?
  birthDate   DateTime? @db.Date
  createdById String?
  createdBy   User?   @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  opportunities Opportunity[]
  sales         Sale[]
  demands       Demand[]

  @@index([name])
  @@index([createdById])
}

model Opportunity {
  id             String             @id @default(cuid())
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  responsibleId  String
  responsible    User               @relation("OpportunityResponsible", fields: [responsibleId], references: [id])
  service        String
  stage          OpportunityStage   @default(NOVO_CONTATO)
  outcome        OpportunityOutcome @default(ABERTA)
  estimatedValue Decimal?           @db.Decimal(12, 2)
  proposalValue  Decimal?           @db.Decimal(12, 2)
  closedValue    Decimal?           @db.Decimal(12, 2)
  priority       Priority           @default(MEDIA)
  waitingOn      WaitingOn          @default(NINGUEM)
  waitingSince   DateTime?
  lastContactAt  DateTime?
  lastActivityAt DateTime           @default(now())
  nextActionAt   DateTime?
  nextAction     String?
  lossReason     String?
  lossNote       String?
  lostAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  interactions CrmInteraction[]
  sale         Sale?

  @@index([stage])
  @@index([responsibleId])
  @@index([customerId])
  @@index([nextActionAt])
  @@index([lastActivityAt])
  @@index([outcome])
}

model CrmInteraction {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  channel       String
  summary       String
  occurredAt    DateTime
  createdAt     DateTime    @default(now())

  @@index([opportunityId, occurredAt])
}

model Sale {
  id            String      @id @default(cuid())
  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  value         Decimal     @db.Decimal(12, 2)
  closedAt      DateTime
  workDate      DateTime?
  clientDueAt   DateTime?
  description   String
  referenceLinks String?
  notes         String?
  createdAt     DateTime    @default(now())
  demand        Demand?

  @@index([customerId])
  @@index([closedAt])
}

model Demand {
  id          String       @id @default(cuid())
  saleId      String?      @unique
  sale        Sale?        @relation(fields: [saleId], references: [id])
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id])
  title       String
  mediaType   DemandMediaType?
  description String?
  hd             String?
  driveUrl       String?
  deliveryLinks  Json     @default("[]")
  status         DemandStatus @default(NOVA)
  clientDueAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  deliverables Deliverable[]
  messages     DemandMessage[]
  files        DemandFile[]
  events       ScheduleEvent[]

  @@index([status])
  @@index([customerId])
  @@index([clientDueAt])
}

model Deliverable {
  id                String            @id @default(cuid())
  demandId          String
  demand            Demand            @relation(fields: [demandId], references: [id], onDelete: Cascade)
  editorId          String?
  editor            User?             @relation("DeliverableEditor", fields: [editorId], references: [id])
  title             String
  description       String?
  status            DeliverableStatus @default(AGUARDANDO_EDITOR)
  editorDueAt       DateTime?
  reviewDueAt       DateTime?
  clientDueAt       DateTime?
  editorDeliveredAt DateTime?
  managerApprovedAt DateTime?
  clientDeliveredAt DateTime?
  archivedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  events ScheduleEvent[]
  scriptAttachments ScriptAttachment[]

  @@index([demandId])
  @@index([editorId])
  @@index([status])
  @@index([editorDueAt])
  @@index([clientDueAt])
}

model ScriptAttachment {
  id           String   @id @default(cuid())
  deliverableId String
  deliverable  Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User @relation(fields: [uploadedById], references: [id])
  fileName     String
  mimeType     String
  size         Int
  content      Bytes
  createdAt    DateTime @default(now())

  @@index([deliverableId, createdAt])
}

model DemandMessage {
  id        String   @id @default(cuid())
  demandId  String
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  system    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([demandId, createdAt])
}

model DemandFile {
  id           String   @id @default(cuid())
  demandId     String
  demand       Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  fileName     String
  storagePath  String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([demandId])
}

model ScheduleEvent {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation("ScheduleOwner", fields: [userId], references: [id])
  createdById   String?
  createdBy     User?             @relation("ScheduleAuthor", fields: [createdById], references: [id])
  demandId      String?
  demand        Demand?           @relation(fields: [demandId], references: [id])
  opportunityId String?
  deliverableId String?
  deliverable   Deliverable?      @relation(fields: [deliverableId], references: [id])
  type          ScheduleEventType
  title         String
  dueAt         DateTime
  completedAt   DateTime?
  status        EventStatus       @default(PENDENTE)
  createdAt     DateTime          @default(now())

  @@index([userId, dueAt])
  @@index([dueAt])
  @@index([demandId])
  @@index([opportunityId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  visibleAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, visibleAt, createdAt])
}

model KanbanLabel {
  stage     String   @id
  label     String
  updatedAt DateTime @updatedAt
}

model Draft {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  content    Json
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

enum ServiceCategory {
  ENSAIOS
  CAPTACAO
  EVENTOS
  PLANOS
  CAMPANHAS
  ESCALAVEIS
  SERVICO_EXTRA
}

enum ServicePriceType {
  FECHADO
  POR_HORA
  MENSAL
}

enum ServiceRecurrence {
  UMA_VEZ
  TRES_MESES
  SEIS_MESES
  UM_ANO
  DATA
}

enum ServiceStatus {
  ATIVO
  ARQUIVADO
}

enum ServiceProposalAction {
  CRIAR
  EDITAR
  ARQUIVAR
  DESARQUIVAR
  EXCLUIR
}

enum ServiceProposalStatus {
  PENDENTE
  AUTORIZADA
  RECUSADA
}

model Service {
  id             String            @id @default(cuid())
  code           String            @unique
  name           String
  category       ServiceCategory
  description    String            @default("")
  referencePrice Decimal?          @db.Decimal(12, 2)
  priceType      ServicePriceType  @default(FECHADO)
  deliveryDays   Int?
  hasSelection   Boolean           @default(false)
  selectionDays  Int?
  recurrence     ServiceRecurrence @default(UMA_VEZ)
  recurrenceDate DateTime?
  standardCost   Decimal?          @db.Decimal(12, 2)
  status         ServiceStatus     @default(ATIVO)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  variations ServiceVariation[]
  proposals  ServiceProposal[]
  usages     ServiceUsage[]

  @@index([category, sortOrder])
  @@index([status])
}

model ServiceVariation {
  id             String   @id @default(cuid())
  serviceId      String
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name           String
  referencePrice Decimal? @db.Decimal(12, 2)
  sortOrder      Int      @default(0)

  @@index([serviceId, sortOrder])
}

model ServiceProposal {
  id           String                @id @default(cuid())
  serviceId    String?
  service      Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  authorId     String
  author       User                  @relation("ServiceProposalAuthor", fields: [authorId], references: [id])
  action       ServiceProposalAction
  payload      Json
  before       Json?
  status       ServiceProposalStatus @default(PENDENTE)
  comment      String                @default("")
  reviewedById String?
  reviewedBy   User?                 @relation("ServiceProposalReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime              @default(now())

  @@index([status, createdAt])
  @@index([serviceId, status])
  @@index([authorId])
}

model ServiceUsage {
  id            String   @id @default(cuid())
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  demandId      String?
  opportunityId String?
  createdAt     DateTime @default(now())

  @@index([serviceId])
}

// Contador único do feed. A linha só é bloqueada na transação do aviso, depois da ação confirmada.
model IntegrationFeedCounter {
  id    String @id @default("feed")
  value BigInt @default(0)
}

// Evento imutável. sequence ordena a publicação; eventId não garante ordem de commit.
model IntegrationEvent {
  id                String   @id
  eventId           String   @unique
  type              String
  schemaVersion     Int
  occurredAt        DateTime
  payload           Json
  deduplicationKey  String   @unique
  scope             String
  sequence          BigInt   @unique

  @@index([scope, sequence])
}
