# Copie para .env na VPS e restrinja: chmod 600 .env
# Não use aspas. Não use espaço, # nem $ nos valores.
# DOMAIN é um nome DNS apontando para a VPS. Não use o IP.

DOMAIN=
ACME_EMAIL=

POSTGRES_USER=garro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=garro

# Host db = serviço PostgreSQL na rede Docker. Não use localhost em produção.
DATABASE_URL=postgresql://garro:change-me@db:5432/garro?schema=public

# Mínimo de 32 caracteres. Gere um valor aleatório. Não reutilize a senha do banco.
SESSION_SECRET=change-me-session-secret-min-32-chars

# Opcional. Padrão do backup: /var/backups/garro
# BACKUP_DIR=/var/backups/garro
